<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.harissabil.editortabgroups</id>
    <name>Editor Tab Groups</name>
    <vendor url="https://github.com/harissabil">harissabil</vendor>
    <description><![CDATA[
        <p>Group editor tabs into named, colored groups that you can collapse and expand right in the tab bar,
        the way tab groups work in web browsers.</p>
        <ul>
            <li>Right-click a tab and choose <b>Add Tab to New Group</b>, then name the group and pick a color.</li>
            <li>Click the group label to collapse or expand the group. Collapsed tabs stay open, including unsaved
                changes; the selected tab stays visible until you switch away.</li>
            <li>Drag tabs into or out of a group, or drag the group label to move the whole group.</li>
            <li>Right-click the label to rename, recolor, copy the file paths, ungroup, save and close, or delete
                the group.</li>
            <li>Saved groups can be reopened later with <b>Reopen Saved Tab Group</b>.</li>
            <li>Each editor split has its own groups. Groups are kept when the IDE restarts.</li>
        </ul>
        <p>Works in IntelliJ-based IDEs, including Android Studio.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.TabGroupsBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.github.harissabil.editortabgroups.platform.TabGroupsStartup"/>
    </extensions>

    <actions>
        <group id="EditorTabGroups.TabMenu">
            <separator/>
            <action id="EditorTabGroups.AddTabToNewGroup"
                    class="com.github.harissabil.editortabgroups.ui.AddTabToNewGroupAction"/>
            <group id="EditorTabGroups.AddTabToGroup"
                   class="com.github.harissabil.editortabgroups.ui.AddTabToGroupMenu"/>
            <action id="EditorTabGroups.RemoveTabFromGroup"
                    class="com.github.harissabil.editortabgroups.ui.RemoveTabFromGroupAction"/>
            <group id="EditorTabGroups.ReopenSavedGroup"
                   class="com.github.harissabil.editortabgroups.ui.ReopenSavedGroupMenu"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="after" relative-to-action="PinActiveEditorTab"/>
        </group>

        <group id="EditorTabGroups.WindowMenu">
            <separator/>
            <action id="EditorTabGroups.ToggleGroup"
                    class="com.github.harissabil.editortabgroups.ui.ToggleTabGroupAction"/>
            <action id="EditorTabGroups.ManageGroup"
                    class="com.github.harissabil.editortabgroups.ui.ManageTabGroupAction"/>
            <reference ref="EditorTabGroups.ReopenSavedGroup"/>
            <add-to-group group-id="WindowMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
